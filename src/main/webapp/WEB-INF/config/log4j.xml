<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Konsole -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%-5p [%t] - %m%n"/>
        </Console>

        <!-- File -->
        <File name="FileLogger" fileName="C:/AdministrationClient.log" append="false">
            <XmlLayout/>
        </File>

        <!-- Socket / Lumbermill -->
        <Socket name="LogServer" host="localhost" port="4445">
            <SerializedLayout/>
        </Socket>
    </Appenders>

    <Loggers>
        <!-- Root-Logger -->
        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
